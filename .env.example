# Environment contract — apps/web (validated by apps/web/src/config/env.ts)
#
# [KHAL-A8] The zod schema in apps/web/src/config/env.ts runs at server
# boot via src/instrumentation.ts (Next instrumentation hook). A REQUIRED
# variable missing at runtime fails fast with a listing of every bad key.
# It does NOT run during `next build` — CI builds with no env vars.
#
# REQUIRED at boot (missing = server refuses to start):
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
#   The Turnstile widget on the booking form renders with this site key
#   (KHAL-A4 wiring). Without it the form would render keyless — hence
#   REQUIRED, and the boot check is what makes it real.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
#   Webhook confirmations write with this elevated key. Missing it means
#   dropped webhook writes, not a degraded feature — hence REQUIRED.
SUPABASE_SERVICE_ROLE_KEY=

# OPTIONAL — each degrades fail-closed to a friendly error, never a
# boot explosion (see the per-key comments in config/env.ts):
#   APP_URL / MP_*: payment checkout returns payment_unavailable.
#   TURNSTILE_SECRET_KEY: createBooking rejects with captcha_failed.
#   UPSTASH_*: booking rate-limit fails OPEN (no limit, traffic flows).
APP_URL=
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
UPSTASH_QSTASH_TOKEN=
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TURNSTILE_SECRET_KEY=
SENTRY_DSN=

# CRITICAL (rotated every 90 days — SEC-02)
QSTASH_CURRENT_SIGNING_KEY=