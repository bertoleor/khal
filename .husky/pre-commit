#!/usr/bin/env sh
# ============================================================================
# khal pre-commit hook — gitleaks (secretos) + lint-staged (fmt/lint)
# Se ejecuta vía .husky/_/h (core.hooksPath=.husky/_). No tocar eso.
#
# REQUISITO gitleaks (obligatorio para scan local): instalá gitleaks en tu máquina
#   - macOS/Linux : brew install gitleaks
#   - Windows     : winget install Gitleaks.Gitleaks   |   scoop install gitleaks
#                   |   choco install gitleaks
#   Si el binario NO está, este hook sigue adelante (graceful skip): el job
#   "Gitleaks" en CI (gitleaks/gitleaks-action@v2) igualmente bloquea secretos.
# Reglas compartidas local+CI: .gitleaks.toml (allowlist de paths build/deps/docs).
# ============================================================================

# Guard contra cuelgues: si encuentra `timeout` del sistema, acota cada comando.
_TIMEOUT=""
if command -v timeout >/dev/null 2>&1; then
  _TIMEOUT="timeout 60"
fi

# >>> gitleaks-pre-commit
if command -v gitleaks >/dev/null 2>&1; then
  if $_TIMEOUT gitleaks protect --staged --redact --exit-code 1 --no-banner --config .gitleaks.toml; then
    echo "✅ gitleaks: sin secretos en staged"
  else
    echo "❌ gitleaks detectó un secreto en los cambios staged." >&2
    echo "   Corregí el archivo señalado, volvé a agregarlo y reintentá el commit." >&2
    echo "   Ver reglas/reglas excluidas en .gitleaks.toml." >&2
    exit 1
  fi
else
  echo "⚠️ gitleaks no instalado — skip local (cubierto por CI). Instalá con:" >&2
  echo "   brew install gitleaks | winget install Gitleaks.Gitleaks | scoop/choco install gitleaks" >&2
fi
# <= gitleaks-pre-commit
. "$(dirname -- "$0")/_/husky.sh"

# lint-staged: solo archivos staged; --no-stash evita el cuelgue histórico del stash.
if [ -x node_modules/.bin/lint-staged ]; then
  if $_TIMEOUT node_modules/.bin/lint-staged --no-stash 2>&1; then
    echo "✅ Pre-commit: lint-staged OK"
  else
    echo "❌ Pre-commit: lint-staged falló — revisá los archivos señalados arriba." >&2
    exit 1
  fi
else
  echo "⚠️ lint-staged no instalado en node_modules — corré pnpm install." >&2
fi